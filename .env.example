# Formspree form ID, used server-side by app/api/contact/route.ts.
# Not NEXT_PUBLIC_: the ID must stay off the client so the form can only be
# submitted through the validating proxy. Defaults to the cognimind.ai form.
FORMSPREE_ID=

# Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile). Both keys
# are needed for bot protection to take effect:
#   - site key renders the widget (public, safe in the bundle)
#   - secret key verifies the token server-side
# Leave both blank to disable: no widget renders and the route skips the
# check, so the form still works. Every other guard stays active regardless.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
